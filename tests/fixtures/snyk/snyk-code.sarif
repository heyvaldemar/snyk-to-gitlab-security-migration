pp.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":16,"endLine":16,"startColumn":12,"endColumn":22}}}}]}]}],"properties":{"isAutofixable":true,"priorityScore":620,"priorityScoreFactors":[{"label":true,"type":"hotFileSource"}]}},{"ruleId":"python/XSS","ruleIndex":4,"level":"error","message":{"text":"Unsanitized input from an HTTP parameter flows into the return value of ping, where it is used to render an HTML page returned to the user. This may result in a Cross-Site Scripting attack (XSS).","markdown":"Unsanitized input from {0} {1} into {2}, where it is used to render an HTML page returned to the user. This may result in a Cross-Site Scripting attack (XSS).","arguments":["[an HTTP parameter](0)","[flows](1),(2),(3),(4),(5)","[the return value of ping](6)"]},"locations":[{"id":0,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":24,"endLine":24,"startColumn":12,"endColumn":35}}}],"fingerprints":{"0":"0bc5913ad10a90448ff765faec9aa0dbf2627f96f9a392c3bdbaa61dea947464","1":"96ff6052.993139d5.79e62dc9.139c59a8.056de048.57d888ee.0a7337bb.4eadf1ec.96ff6052.83099170.13aa4cd9.139c59a8.cb2ee61d.ba14daf2.22a8b49e.073a31b1"},"codeFlows":[{"threadFlows":[{"locations":[{"location":{"id":0,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":22,"endLine":22,"startColumn":12,"endColumn":28}}}},{"location":{"id":1,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":22,"endLine":22,"startColumn":12,"endColumn":28}}}},{"location":{"id":2,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":22,"endLine":22,"startColumn":5,"endColumn":49}}}},{"location":{"id":3,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":24,"endLine":24,"startColumn":51,"endColumn":55}}}},{"location":{"id":4,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":24,"endLine":24,"startColumn":36,"endColumn":55}}}},{"location":{"id":5,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":24,"endLine":24,"startColumn":12,"endColumn":35}}}},{"location":{"id":6,"physicalLocation":{"artifactLocation":{"uri":"app.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":24,"endLine":24,"startColumn":12,"endColumn":35}}}}]}]}],"properties":{"isAutofixable":true,"priorityScore":620,"priorityScoreFactors":[{"label":true,"type":"hotFileSource"}]}}],"properties":{"coverage":[{"files":2,"isSupported":true,"lang":".py","type":"SUPPORTED"}]},"automationDetails":{"id":"Snyk/Code/2026-10-28T16:03:19Z"}}]}
